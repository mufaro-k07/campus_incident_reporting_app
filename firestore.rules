rules_version = '2';

// Final rules for the demo. Only verified @alustudent.com and
// @alueducation.com accounts can use the database.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function hasAluEmail() {
      return request.auth.token.email.matches('.*@(alustudent|alueducation)[.]com');
    }

    function verified() {
      return signedIn()
        && request.auth.token.email_verified == true
        && hasAluEmail();
    }

    function isStaff() {
      return verified()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'staff';
    }

    function changesOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    match /users/{userId} {
      allow read: if verified() && (request.auth.uid == userId || isStaff());

      allow create: if verified()
        && request.auth.uid == userId
        && request.resource.data.role == 'student';

      // Users may update their own profile, but never their own role.
      allow update: if verified()
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role;
    }

    match /incidents/{incidentId} {
      allow read: if verified();

      allow create: if verified()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'submitted';

      // Staff move the status forward. The reporter can fix their own report
      // while nobody has started on it yet.
      allow update: if (isStaff()
          && changesOnly(['status', 'statusHistory', 'updatedAt']))
        || (verified()
          && resource.data.reporterId == request.auth.uid
          && resource.data.status == 'submitted'
          && changesOnly(['title', 'description', 'category', 'location', 'photoUrl', 'updatedAt']));

      allow delete: if verified()
        && resource.data.reporterId == request.auth.uid
        && resource.data.status == 'submitted';
    }
  }
}
